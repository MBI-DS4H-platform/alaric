#!/usr/bin/env bash
set -euo pipefail

# alaric-count-poses — count poses in an organized pose directory (or a
# single .arc/.arc.zst file), via count-poses.py.
#
# Usage:
#   alaric-count-poses [POSE_DIR] [--per-file]
#
# Arguments:
#   POSE_DIR    organized pose directory (poses-*.arc) or a single
#               .arc/.arc.zst file. If omitted, "./results" is used
#               (it must exist in the current directory).
#   --per-file  also print the pose count for each .arc file

usage() {
  echo "Usage: alaric-count-poses [POSE_DIR] [--per-file]" >&2
}

PYTHON="${PYTHON:-python}"

# Installed via [tool.setuptools] script-files, so this file is a plain copy
# in the environment's bin/, not necessarily next to count-poses.py. Locate
# count-poses.py through the installed "alaric" package instead of relative
# to this script.
SCRIPT_DIR="$("${PYTHON}" -c 'import os, alaric; print(os.path.join(os.path.dirname(os.path.abspath(alaric.__file__)), "util"))')"

has_target=0
for arg in "$@"; do
  case "${arg}" in
    -*) ;;
    *) has_target=1; break ;;
  esac
done

if [[ "${has_target}" -eq 0 ]]; then
  if [[ ! -d results ]]; then
    echo "error: no pose dir given and no 'results' directory found in $(pwd)" >&2
    usage
    exit 2
  fi
  set -- results "$@"
fi

exec "${PYTHON}" "${SCRIPT_DIR}/count-poses.py" "$@"
