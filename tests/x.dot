digraph pose_pools {
  rankdir=LR;
  node [shape=box];
  "frag10-anchor" [label="frag10-anchor\nfrag10 anchor"];
  "frag10-anchor-filter" [label="frag10-anchor-filter\nfrag10 filter"];
  "frag10-anchor-filter-BAD" [label="frag10-anchor-filter-BAD\nfrag10 filter"];
  "frag10-fwd-restrict" [label="frag10-fwd-restrict\nfrag10 grow", style=filled, fillcolor=lightblue];
  "frag4-anchor-bwd" [label="frag4-anchor-bwd\nfrag4 anchor"];
  "frag4-anchor-fwd" [label="frag4-anchor-fwd\nfrag4 anchor"];
  "frag4-merged" [label="frag4-merged\nfrag4 merge"];
  "frag4-merged-filter" [label="frag4-merged-filter\nfrag4 filter", style=filled, fillcolor=lightblue];
  "frag5-anchor" [label="frag5-anchor\nfrag5 anchor"];
  "frag5-fwd" [label="frag5-fwd\nfrag5 grow"];
  "frag5-fwd-filter" [label="frag5-fwd-filter\nfrag5 filter"];
  "frag5-merged" [label="frag5-merged\nfrag5 merge", style=filled, fillcolor=lightblue];
  "frag6-fwd" [label="frag6-fwd\nfrag6 grow"];
  "frag6-fwd-filter" [label="frag6-fwd-filter\nfrag6 filter", style=filled, fillcolor=lightblue];
  "frag7-fwd" [label="frag7-fwd\nfrag7 grow"];
  "frag7-fwd-filter" [label="frag7-fwd-filter\nfrag7 filter", style=filled, fillcolor=lightblue];
  "frag8-fwd" [label="frag8-fwd\nfrag8 grow"];
  "frag8-fwd-filter" [label="frag8-fwd-filter\nfrag8 filter", style=filled, fillcolor=lightblue];
  "frag9-fwd" [label="frag9-fwd\nfrag9 grow"];
  "frag9-fwd-filter" [label="frag9-fwd-filter\nfrag9 filter", style=filled, fillcolor=lightblue];
  "frag10-anchor-filter" -> "frag10-anchor" [label="filter:provenance.npy", style=solid];
  "frag10-anchor-filter-BAD" -> "frag10-anchor" [label="filter:provenance.npy", style=solid];
  "frag10-fwd-restrict" -> "frag9-fwd-filter" [label="grow:provenance.npy", style=solid];
  "frag10-fwd-restrict" -> "frag10-anchor-filter" [label="restrict", style=dashed];
  "frag4-merged" -> "frag4-anchor-fwd" [label="merge:map-1.npy", style=solid];
  "frag4-merged" -> "frag4-anchor-bwd" [label="merge:map-2.npy", style=solid];
  "frag4-merged-filter" -> "frag4-merged" [label="filter:provenance.npy", style=solid];
  "frag5-fwd" -> "frag4-merged-filter" [label="grow:provenance.npy", style=solid];
  "frag5-fwd-filter" -> "frag5-fwd" [label="filter:provenance.npy", style=solid];
  "frag5-merged" -> "frag5-fwd-filter" [label="merge:map-1.npy", style=solid];
  "frag5-merged" -> "frag5-anchor" [label="merge:map-2.npy", style=solid];
  "frag6-fwd" -> "frag5-merged" [label="grow:provenance.npy", style=solid];
  "frag6-fwd-filter" -> "frag6-fwd" [label="filter:provenance.npy", style=solid];
  "frag7-fwd" -> "frag6-fwd-filter" [label="grow:provenance.npy", style=solid];
  "frag7-fwd-filter" -> "frag7-fwd" [label="filter:provenance.npy", style=solid];
  "frag8-fwd" -> "frag7-fwd-filter" [label="grow:provenance.npy", style=solid];
  "frag8-fwd-filter" -> "frag8-fwd" [label="filter:provenance.npy", style=solid];
  "frag9-fwd" -> "frag8-fwd-filter" [label="grow:provenance.npy", style=solid];
  "frag9-fwd-filter" -> "frag9-fwd" [label="filter:provenance.npy", style=solid];
  "frag10-fwd-restrict" -> "frag9-fwd-filter" [label="chain forward", color=red, penwidth=2, constraint=false];
  "frag5-merged" -> "frag4-merged-filter" [label="chain forward", color=red, penwidth=2, constraint=false];
  "frag6-fwd-filter" -> "frag5-merged" [label="chain forward", color=red, penwidth=2, constraint=false];
  "frag7-fwd-filter" -> "frag6-fwd-filter" [label="chain forward", color=red, penwidth=2, constraint=false];
  "frag8-fwd-filter" -> "frag7-fwd-filter" [label="chain forward", color=red, penwidth=2, constraint=false];
  "frag9-fwd-filter" -> "frag8-fwd-filter" [label="chain forward", color=red, penwidth=2, constraint=false];
}
